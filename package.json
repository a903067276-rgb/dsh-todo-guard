{
  "name": "dsh-todo-guard",
  "version": "2.3.1",
  "description": "Reliable todo panel for DSH: review dock survives restarts, verifies completion evidence submitted through its own tool (official todo panel stays clean)",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "assets",
    "locale"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "todo",
    "verification"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.0.1",
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/a903067276-rgb/dsh-todo-guard.git"
  },
  "dsh": {
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-alpha.2 || ^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
